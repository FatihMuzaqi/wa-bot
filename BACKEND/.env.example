NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=whatsapp_bot_platform
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=replace-with-evolution-api-key
EVOLUTION_INSTANCE=default
SOCKET_CORS_ORIGIN=*
REDIS_URL=
BOT_ENGINE_CONCURRENCY=3
AI_FALLBACK_MESSAGE=...
AI_FALLBACK_CONFIDENCE=0.5
BOT_AI_LOW_CONFIDENCE_ACTION=transfer
AI_PROVIDER=placeholder
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
AI_CONFIDENCE_THRESHOLD=0.65
AI_MAX_CONTEXT_CHUNKS=5
BROADCAST_QUEUE_CONCURRENCY=2
BROADCAST_MAX_RETRIES=3
BROADCAST_RETRY_DELAY_MS=5000
BROADCAST_SCHEDULER_INTERVAL_MS=60000
SCHEDULER_CRON_EXPRESSION=*/1 * * * *
SCHEDULER_TIMEZONE=Asia/Jakarta
FORM_SUBMISSION_WEBHOOK_URL=
FORM_SUBMISSION_WEBHOOK_TOKEN=
FORM_SUBMISSION_WEBHOOK_TIMEOUT_MS=15000
SOCKET_CORS_ORIGIN=*
REDIS_URL=
